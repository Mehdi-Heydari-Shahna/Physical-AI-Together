#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "chassis_collision" (
        prepend references = @./geometries.usd@</Geometries/chassis_collision>
    )
    {
        over "chassis_collision" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            token purpose = "guide"

            def Scope "material"
            {
                custom string urdf:name = "clearpath_yellow"
            }
        }
    }

    def Xform "bumper_collision" (
        prepend references = @./geometries.usd@</Geometries/bumper_collision>
    )
    {
        over "bumper_collision" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            token purpose = "guide"
        }
    }
}

