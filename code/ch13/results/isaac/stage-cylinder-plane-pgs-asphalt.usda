over "Render"
{
    over "OmniverseKit"
    {
        over "HydraTextures"
        {
            over "omni_kit_widget_viewport_ViewportTexture_0"
            {
                custom uint64 viewPickingId = 16637400363856224320
                custom int viewportHandle = 0
            }
        }
    }
}

